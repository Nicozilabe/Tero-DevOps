# Base de datos PostgreSQL
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_DB=orders
DB_SSLMODE=disable

# Panel de administración
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN_PASSWORD
ADMIN_JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET_MIN_32_CHARS
COOKIE_SECURE=false

# Control de entorno / trazabilidad
ENABLE_CHAOS=false
APP_VERSION=local
